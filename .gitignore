# dependencies
/node_modules/
# the substrate carries its own manifest, so it installs its own tree beside it. Narrow
# on purpose: a source file added under agent/ stays trackable with no edit here.
/agent/node_modules/

# a run's records and transcripts. They live in the project folder so the project stays
# reconstructible from it alone, and they are not versioned: transcripts are large and
# append constantly, and committing them would bury every source change under a wall of
# them. Narrow on purpose — `.jen/` is left free for anything that should be tracked
/.jen/runs/

# build output: compiled CLI and the payload staged into dist/templates/ at pack time
/dist/
*.tgz

# the governed project's sources, checked out here and never jen's to track
/src/

# regenerated locally by `openspec init` from the version we depend on. tracking these
# re-vendors the frozen snapshot this repository just removed
/.claude/skills/openspec-*/
/.claude/commands/opsx/

# per-install, never shared: MCP server ids differ from one install to the next, and a
# contributor's own permission grants belong here rather than in the tracked settings file
/.claude/settings.local.json

# local agent scratch: embedded git repos, never part of the workflow
/.claude/worktrees/
