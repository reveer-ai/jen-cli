# dependencies
/node_modules/

# build output: compiled CLI and the payload staged into dist/templates/ at pack time
/dist/
*.tgz

# the governed project's sources, checked out here and never jen's to track
/src/

# regenerated locally by `openspec init` from the version we depend on. tracking these
# re-vendors the frozen snapshot this repository just removed
/.claude/skills/openspec-*/
/.claude/commands/opsx/

# per-install, never shared: MCP server ids differ from one install to the next, and a
# contributor's own permission grants belong here rather than in the tracked settings file
/.claude/settings.local.json

# local agent scratch: embedded git repos, never part of the workflow
/.claude/worktrees/
